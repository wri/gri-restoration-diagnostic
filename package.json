{
  "name": "rd-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "db:reset": "psql -h ${DB_HOST:-rd-app-db2.c9o0i0gg61en.us-east-1.rds.amazonaws.com} -U ${DB_USER:-postgres} -d ${DB_NAME:-dev} -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'",
    "db:drop-tables": "psql -h ${DB_HOST:-rd-app-db2.c9o0i0gg61en.us-east-1.rds.amazonaws.com} -U ${DB_USER:-postgres} -d ${DB_NAME:-dev} -c 'DROP TABLE IF EXISTS migrations, assessments, lead, region, diagnostic CASCADE; DROP TYPE IF EXISTS assessments_project_type_enum CASCADE;'",
    "typeorm": "ts-node --project tsconfig.typeorm.json -r dotenv/config ./node_modules/typeorm/cli.js",
    "migration:generate": "DOTENV_CONFIG_PATH=.env npm run typeorm -- migration:generate src/db/migrations/Migration -d src/db/migration-data-source.ts",
    "migration:run": "DOTENV_CONFIG_PATH=.env npm run typeorm -- migration:run -d src/db/migration-data-source.ts",
    "migration:revert": "DOTENV_CONFIG_PATH=.env npm run typeorm -- migration:revert -d src/db/migration-data-source.ts",
    "seed:run": "DOTENV_CONFIG_PATH=.env ts-node --project tsconfig.typeorm.json -r dotenv/config src/db/seeds/index.ts",
    "db:query": "DOTENV_CONFIG_PATH=.env ts-node --project tsconfig.typeorm.json -r dotenv/config src/db/scripts/run-query.ts",
    "i18n:import-csv": "DOTENV_CONFIG_PATH=.env ts-node --project tsconfig.typeorm.json -r dotenv/config src/i18n/scripts/import-question-csv.ts",
    "i18n:cleanup": "DOTENV_CONFIG_PATH=.env ts-node --project tsconfig.typeorm.json -r dotenv/config src/i18n/scripts/cleanup-questions.ts",
    "i18n:export-questions": "DOTENV_CONFIG_PATH=.env ts-node --project tsconfig.typeorm.json -r dotenv/config src/i18n/scripts/sync-translations.ts --export",
    "i18n:import-questions": "DOTENV_CONFIG_PATH=.env ts-node --project tsconfig.typeorm.json -r dotenv/config src/i18n/scripts/sync-translations.ts --import",
    "i18n:validate": "DOTENV_CONFIG_PATH=.env ts-node --project tsconfig.typeorm.json -r dotenv/config src/i18n/scripts/validate-translations.ts"
  },
  "dependencies": {
    "@chakra-ui/charts": "^3.30.0",
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@next/third-parties": "^16.2.1",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-font-family": "^3.19.0",
    "@tiptap/extension-highlight": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-subscript": "^3.19.0",
    "@tiptap/extension-superscript": "^3.19.0",
    "@tiptap/extension-text-align": "^3.19.0",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@worldresources/wri-design-systems": "^2.189.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.2.3",
    "next": "15.5.0",
    "pg": "^8.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "recharts": "^3.6.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.33.0",
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "14.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1"
  }
}
